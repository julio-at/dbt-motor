-- Spectra: rename, cast, keep bins as array
with source as (
  select * from "motor_health_lab"."raw"."spectra"
),

renamed as (
  select
    timestamp::timestamp_ns as timestamp_ns,
    device_id,
    axis,
    fs_hz,
    n_samples,
