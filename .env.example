# Motor Health Lab environment variables
# Copy to .env and fill in if needed

# Database
DUCKDB_PATH=.duckdb

# Streamlit
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# dbt (if using profiles)
DBT_PROFILES_DIR=.

# Generator
GENERATOR_SEED=42
GENERATOR_PROFILE=dev
